# Copy to .env (git-ignored) before `docker compose up`:   cp .env.example .env
# The values below are DEV ONLY. Production values are written to .env by the deploy.

# --- PostgreSQL (infra/postgres) ---
POSTGRES_DB=familyapp
POSTGRES_USER=admin
POSTGRES_PASSWORD=postgres
DB_OWNER_PASSWORD=owner-dev-password
DB_APP_PASSWORD=app-dev-password
POSTGRES_BIND=127.0.0.1
# pg_hba profile: dev | prod
PG_HBA=dev

# Where the backend finds Postgres (service name in compose; a host name once it moves)
DB_HOST=postgres

# --- Backend ---
# APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost,http://0.0.0.0
