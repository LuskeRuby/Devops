# The backends all run on Server A, one port each. NGINX round robins requests across them and stops
# using one that fails 3 times in a row for 10 s. The server lines come from BACKEND_SERVERS, which the
# release builds from the BACKEND_COUNT variable.
upstream backend {
    ${BACKEND_SERVERS}
    keepalive 16;
}

# ---- Hardening: http-level part -------------------------------------------------------------------
# This part only defines things. The 443 server below decides where they apply, so the internal 8080
# server (Docker health check, nginx exporter) is never rate limited or blocked.

# No version number in the Server header and on nginx's own error pages.
server_tokens off;

# Rate limiting per client IP, one zone for family login and one for the PIN. The maps pick out the two
# URLs. Every other request gets an empty key, and nginx does not count requests with an empty key.
# nginx only knows IP addresses, so a lockout per account is still needed in the app (backlog H3).
map $uri $login_key {
    default                              "";
    ~^/api/families/login/?$             $binary_remote_addr;
}
map $uri $pin_key {
    default                              "";
    ~^/api/users/[0-9]+/validate-pin/?$  $binary_remote_addr;
}
limit_req_zone $login_key zone=login:1m rate=5r/m;
limit_req_zone $pin_key   zone=pin:1m   rate=5r/m;
limit_req_status 429;

# Open connections per IP. A WebSocket stays open and a browser opens several connections.
limit_conn_zone $binary_remote_addr zone=perip:10m;
limit_conn_status 429;

server {
    listen 80;
    server_name ${IP_FRONTEND_PUBLIC};

    # Automatically redirect to HTTPS
    return 301 https://$host$request_uri;
}

# The actual HTTPS server
server {
    listen 443 ssl;
    server_name ${IP_FRONTEND_PUBLIC};

    # Point to the certificates mounted via docker-compose
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    # TLS: only 1.2 and 1.3. For 1.2 only ECDHE key exchange with AEAD ciphers (forward secrecy). The
    # TLS 1.3 cipher suites are fixed and are not set by ssl_ciphers.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Request limits. 2m is the room for Spring's 1 MB image limit plus the multipart overhead.
    # This slows down slow-client attacks but is no DDoS protection.
    client_max_body_size 2m;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    limit_conn perip 30;

    # Security headers. A location that has its own add_header drops all of these, so don't add one there.
    # No HSTS: browsers ignore it on an IP address, and it can lock people out when the certificate is
    # self-signed. Add it when we get a domain and a trusted certificate.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # CSP in report-only mode first: violations only show in the browser console and nothing is blocked.
    # Remove "-Report-Only" once the app runs without violations.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' wss://$host; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    root /usr/share/nginx/html;
    index index.html;

    # Never serve dotfiles or dot folders (.git, .env, ...).
    location ~ /\. {
        deny all;
    }

    # SPA fallback — all routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the backend service to avoid CORS
    location /api/ {
        # Only the methods the backend uses. Everything else gets 403 before it reaches the backend.
        limit_except GET POST PUT DELETE { deny all; }
        # Family login and PIN, see the zones at the top. Six requests at once, then five per minute per IP.
        limit_req zone=login burst=5 nodelay;
        limit_req zone=pin burst=5 nodelay;
        proxy_pass http://backend;
        proxy_http_version 1.1;
        # If one backend is down or answers 502/503 (for example while it restarts in a release), try the
        # other one. POST is not retried after the request was sent (nginx default), so nothing is posted twice.
        proxy_connect_timeout 3s;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme; # Tells Spring Boot we are using HTTPS
        proxy_set_header Connection "";
    }

    # Proxy WebSocket requests to backend
    location /websocket {
        # The upgrade handshake is a GET.
        limit_except GET { deny all; }
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
        # nginx closes a proxied connection that carries no data for 60 s by default. STOMP
        # heartbeats (every 10 s) keep it busy; this is the safety net if they ever stop.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Internal only: port 8080 is not published. Docker's health check and the nginx exporter use it.
server {
    listen 8080;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    location = /stub_status {
        stub_status;
        access_log off;
    }
}
