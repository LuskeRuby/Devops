# This is for scaling across multiple servers. NGINX round robins requests across them.
upstream backend {
    server ${IP_BACKEND_WG}:8080; # remove this once we transfer to multiple backends
   #server ${IP_BACKEND_WG}:8081;
   #server ${IP_BACKEND_WG}:8082;
    keepalive 16;
}

server {
    listen 80;
    server_name ${IP_FRONTEND_PUBLIC};

    # Automatically redirect to HTTPS
    return 301 https://$host$request_uri;
}

# The actual HTTPS server
server {
    listen 443 ssl;
    server_name ${IP_FRONTEND_PUBLIC};

    # Point to the certificates mounted via docker-compose
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;

    # Standard security headers
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback — all routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to the backend service to avoid CORS
    location /api/ {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme; # Tells Spring Boot we are using HTTPS
        proxy_set_header Connection "";
    }

    # Proxy WebSocket requests to backend
    location /websocket {
        proxy_pass http://backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
