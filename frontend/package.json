    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@phosphor-icons/web": "^2.1.2",
    "@stomp/stompjs": "^7.3.0",
    "angular-calendar": "^0.32.0",
