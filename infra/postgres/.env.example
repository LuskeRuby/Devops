# For running infra/postgres/docker-compose.yml on its own (e.g. on the database server):
#   cp infra/postgres/.env.example infra/postgres/.env
# When started from the repo root, the root
# .env is used instead (see ../../.env.example).
POSTGRES_DB=familyapp
POSTGRES_USER=admin
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=

# Address Postgres is published on. Loopback by default; on a database server use its
# private/VPN address and firewall port 5432 to the app server only.
POSTGRES_BIND=127.0.0.1

# Which pg_hba.<name>.conf to load: dev | prod | remote
PG_HBA=prod
